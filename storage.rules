rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 写真: 推測できないランダムなIDの画像リンクを知っていれば見られる。アップロード・削除はメンバーだけ。
    match /photos/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['member', 'admin']
        && (request.method == 'delete' || (request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
